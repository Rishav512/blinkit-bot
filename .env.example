# Telegram Bot Configuration
# 1. Create a bot using @BotFather on Telegram to get your bot token
# 2. Get your Chat ID by messaging @userinfobot or checking https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ajio Tracker Polling Interval (in minutes, default: 15)
AJIO_POLL_INTERVAL_MINS=15

# Browser Mode: set to true for headless (background), false for visible browser window (default: false)
HEADLESS=false


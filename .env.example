# Telegram Bot Configuration
# 1. Create a bot using @BotFather on Telegram to get your bot token
# 2. Get your Chat ID by messaging @userinfobot or checking https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Store Operating Hours (IST - Indian Standard Time)
# Blinkit store closed window (default: 1 AM to 5 AM IST)
STORE_CLOSED_START_HOUR=1
STORE_CLOSED_END_HOUR=5

# Polling Interval (in minutes, default: 5)
POLL_INTERVAL_MINS=5

# Render Bandwidth Optimization (blocks heavy images/fonts during restock polling)
# Keeps Render egress bandwidth safely under 100GB monthly limit (default: true)
BLOCK_MEDIA_ASSETS=true
